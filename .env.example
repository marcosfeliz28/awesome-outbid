# «options» fija la sesión de PostgreSQL en UTC, que es como Prisma guarda las
# fechas. Es una defensa adicional: el código no depende de la zona horaria del
# servidor ni del rol. Consérvalo al cambiar el servidor, el puerto o la base.
DATABASE_URL=postgresql://fitstore:fitstore_local@localhost:5434/fitstore?options=-c%20TimeZone%3DUTC
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
PORT=3001
# Opcional, solo para copias de prueba locales: "127.0.0.1" evita que otro
# equipo de la misma red LAN alcance la API. NO poner esto en producción ni
# en el instalador de Windows (necesitan "0.0.0.0", el default si se omite).
API_HOST=
ENABLE_SWAGGER=false
VITE_SHOW_DEMO_CREDENTIALS=false
SEED_DEMO_PASSWORD=FitStore-Demo-2026!

# Opcional: extracción de fotos/PDF. Sin clave sólo se habilita Excel/CSV.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# IA de ventas («Preguntar a Norexos»): modelo económico y plan por sucursal.
# Sin ANTHROPIC_API_KEY o sin plan queda apagada. Plan: medio (10/día por usuario)
# o completo (30/día); "completo" vale para todas, o "main:completo,otra:medio".
ASSISTANT_MODEL=claude-haiku-5-5
IA_VENTAS_PLAN=

# Pool de conexiones de la API a PostgreSQL (apps/api/src/database-pool.ts).
# Si DATABASE_URL no trae connection_limit/pool_timeout se usan estos valores
# (por defecto 10 conexiones y 20 s de espera por una conexión libre).
# NEXORA_DB_CONNECTION_LIMIT=10
# NEXORA_DB_POOL_TIMEOUT=20

# Baja de cliente (solo el comando pnpm --filter @fitstore/api baja; la API no
# las lee). Ver docs/operacion/BAJA_DE_CLIENTE.md. Nunca guardar valores aquí.
# BAJA_CLAVE=                  frase del paquete cifrado (32+ caracteres)
# BAJA_DIAS_MINIMOS=30         solo sube el piso fijo de 30 días
# BAJA_SUCURSALES_PROTEGIDAS=  agrega sucursales protegidas («main» siempre lo está)
