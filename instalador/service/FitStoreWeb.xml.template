<service>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <id>FitStoreWeb</id>
  <name>FitStore POS - Web HTTPS</name>
  <description>Interfaz HTTPS y proxy local de FitStore POS.</description>
  <executable>{{NODE_EXE}}</executable>
  <arguments>&quot;{{WEB_SERVER}}&quot; &quot;{{SERVER_CONFIG}}&quot;</arguments>
  <workingdirectory>{{INSTALL_DIR}}</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <startmode>{{SERVICE_START_MODE}}</startmode>
  <delayedAutoStart>{{DELAYED_AUTO_START}}</delayedAutoStart>
  <depend>FitStoreAPI</depend>
  <stoptimeout>30sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <keepFiles>14</keepFiles>
  </log>
</service>
