<service>
  <serviceaccount>
    <domain>NT SERVICE</domain>
    <user>FitStoreAPI</user>
  </serviceaccount>
  <id>FitStoreAPI</id>
  <name>FitStore POS - API</name>
  <description>Servidor privado de datos de FitStore POS.</description>
  <executable>{{NODE_EXE}}</executable>
  <arguments>&quot;{{API_MAIN}}&quot;</arguments>
  <workingdirectory>{{API_WORKDIR}}</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <startmode>{{SERVICE_START_MODE}}</startmode>
  <delayedAutoStart>{{DELAYED_AUTO_START}}</delayedAutoStart>
  <depend>FitStorePostgreSQL</depend>
  <stoptimeout>30sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <keepFiles>14</keepFiles>
  </log>
</service>
