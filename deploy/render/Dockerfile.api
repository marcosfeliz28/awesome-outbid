# syntax=docker/dockerfile:1.7
FROM node:24.21.0-bookworm-slim AS build

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@11.19.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --filter @fitstore/api...

COPY tsconfig.base.json ./
COPY apps/api apps/api
COPY packages/shared packages/shared
COPY deploy/render/with-cloud-env.mjs deploy/render/with-cloud-env.mjs
COPY deploy/render/post-deploy-check.mjs deploy/render/post-deploy-check.mjs
RUN pnpm --filter @fitstore/api db:generate \
    && pnpm --filter @fitstore/api build

# N6 (auditoría 04 v2): pg_dump/pg_restore 17 salen de la imagen oficial de
# PostgreSQL 17.11 sobre Debian bookworm (el de la imagen de Node, para que las
# librerías coincidan), fijada por suma, en vez de bajarse en cada construcción de
# postgresql.org y apt.postgresql.org: un corte de PGDG ya no impide construir
# una corrección urgente (Docker Hub ya es una dependencia: node, esta imagen).
# Para actualizar el cliente, cambiar versión y suma aquí a la vez.
FROM postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826 AS pgclient

FROM node:24.21.0-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
# Cliente PostgreSQL 17 para el respaldo diario a Google Drive
# (apps/api/src/drive-backup.ts, docs/RESPALDO_DRIVE.md): la base de Render es
# PostgreSQL 17 y pg_dump se niega a respaldar un servidor más nuevo que él,
# así que el cliente 15 de Debian no sirve. Sólo se copian pg_dump, pg_restore
# y libpq (la que traen ya compilados con esa versión); el resto de sus
# librerías son paquetes de Debian bookworm. Sin servidor PostgreSQL. La
# compilación falla si a pg_dump le falta una librería o no arranca.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
        libgssapi-krb5-2 libldap-2.5-0 libsasl2-2 libzstd1 liblz4-1 libxxhash0 zlib1g \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=from=pgclient,source=/usr/lib,target=/pg \
    set -eux; \
    libdir="$(ls -d /usr/lib/*-linux-gnu | head -n 1)"; \
    install -d /usr/lib/postgresql/17/bin; \
    install -m 755 /pg/postgresql/17/bin/pg_dump /pg/postgresql/17/bin/pg_restore /usr/lib/postgresql/17/bin/; \
    cp -a /pg/*-linux-gnu/libpq.so.5* "$libdir"/; \
    ldconfig; \
    if ldd /usr/lib/postgresql/17/bin/pg_dump /usr/lib/postgresql/17/bin/pg_restore | grep "not found"; then exit 1; fi; \
    /usr/lib/postgresql/17/bin/pg_dump --version; \
    /usr/lib/postgresql/17/bin/pg_restore --version
ENV PG_DUMP_BIN=/usr/lib/postgresql/17/bin/pg_dump
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||10000)+'/api/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
# Un solo proceso node: with-cloud-env.mjs prepara DATABASE_URL y carga la API
# en el mismo proceso (antes lanzaba un segundo node que quedaba residente,
# ~46 MB). Montón de V8 limitado a 256 MB para que, con el motor de Prisma y
# el código (~130 MB), la API quepa holgada en 512 MB (medido con 0.5c-512mb;
# el plan real 1c-2g de render.yaml deja más margen).
CMD ["node", "--max-old-space-size=256", "deploy/render/with-cloud-env.mjs", "apps/api/dist/main.js"]
