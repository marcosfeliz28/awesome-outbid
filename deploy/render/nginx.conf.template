# IP real del cliente (S-01/S-02/S-04, auditoría de seguridad 2026-10-10).
# En Render la cadena es Cloudflare → proxy de Render → Nginx, así que
# $remote_addr es la del proxy y es la misma para todos los clientes.
# Cloudflare fija CF-Connecting-IP con la IP que abrió la conexión y
# reemplaza la que envíe el navegador; se acepta SÓLO si la conexión llega
# desde la red interna del borde (nexora-trusted-edge.conf, que genera
# start-nginx.sh desde NEXORA_TRUSTED_EDGE_CIDRS) y es una IP con forma
# válida. X-Forwarded-For del cliente nunca se usa: Render la conserva y sólo
# añade al final. Sin cabecera válida se usa la IP de la conexión, como antes.
geo $remote_addr $nexora_trusted_edge {
    default 0;
    include /etc/nginx/snippets/nexora-trusted-edge.conf;
}

map "$nexora_trusted_edge|$http_cf_connecting_ip" $nexora_client_ip {
    default $remote_addr;
    "~^1\|(?<nexora_cf_ipv4>[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})$" $nexora_cf_ipv4;
    "~^1\|(?<nexora_cf_ipv6>[0-9A-Fa-f]{0,4}:[0-9A-Fa-f:.]{1,44})$" $nexora_cf_ipv6;
}

# Referrer-Policy por ruta (lo consume security-headers.conf): la API conserva
# la política más estricta que ya enviaba (`no-referrer`) y la web usa la
# habitual para una SPA. Así hay una sola cabecera por respuesta.
map $uri $nexora_referrer_policy {
    default "strict-origin-when-cross-origin";
    ~^/api/ "no-referrer";
}

# La IP de la API la mantiene start-nginx.sh (re-resuelve cada 10 s y recarga).
upstream nexora_api {
    include /etc/nginx/snippets/nexora-api-upstream.conf;
    keepalive 16;
}

server {
    listen ${PORT};
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 5m;
    include /etc/nginx/snippets/nexora-security-headers.conf;

    # Compresión de texto: HTML, JS, CSS, SVG, manifiesto y JSON de la API (el
    # catálogo pesa ~900 KB sin comprimir). Las imágenes y fuentes ya
    # comprimidas (png, jpg, webp, woff2) no están en la lista. No cambia
    # cabeceras de seguridad ni Cache-Control; el ETag pasa a débil. El flujo
    # de eventos (/api/events) no se comprime: retendría los eventos.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # Liveness sólo de Nginx: Render lo usa como healthCheckPath de la web y no
    # debe fallar mientras la API se redespliega (reiniciaría la web en bucle).
    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        return 204;
    }

    # Comprobación profunda, para uso manual o externo (NO para Render): la web
    # sólo es sana si la API y su base de datos responden (/api/health/ready).
    # auth_request descarta el cuerpo de la API y sólo se devuelve 204/503,
    # sin detalles.
    location = /healthz/deep {
        access_log off;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        auth_request /_nexora_api_ready;
        error_page 500 502 503 504 =503 @nexora_api_down;
        # `return` se evalúa antes de auth_request; try_files, después.
        try_files /nexora-inexistente @nexora_healthy;
    }

    location @nexora_healthy {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        return 204;
    }

    location = /_nexora_api_ready {
        internal;
        proxy_pass http://nexora_api/api/health/ready;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    location @nexora_api_down {
        add_header Cache-Control "no-store" always;
        return 503;
    }

    location = /api/events {
        proxy_pass http://nexora_api;
        # Nginx es la única fuente de las cabeceras de seguridad también en /api:
        # se descartan las que ya añade Helmet (valores distintos o duplicados)
        # y se aplican las de security-headers.conf, heredadas del server.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $nexora_client_ip;
        proxy_set_header X-Forwarded-For $nexora_client_ip;
        # La API sólo usa X-Forwarded-For; las cabeceras del borde no pasan.
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        add_header X-Accel-Buffering no;
    }

    # `^~` evita que las reglas de archivos estáticos (más abajo) afecten a /api.
    location ^~ /api/ {
        proxy_pass http://nexora_api;
        # Nginx es la única fuente de las cabeceras de seguridad también en /api:
        # se descartan las que ya añade Helmet (valores distintos o duplicados)
        # y se aplican las de security-headers.conf, heredadas del server.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $nexora_client_ip;
        proxy_set_header X-Forwarded-For $nexora_client_ip;
        # La API sólo usa X-Forwarded-For; las cabeceras del borde no pasan.
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        # Errores generados por Nginx (no los de la API): la API no está
        # disponible (502) o tardó más de 60 s (504). Se conserva el código,
        # que la PWA trata como «sin conexión», con un mensaje JSON claro.
        error_page 502 @nexora_api_unavailable;
        error_page 504 @nexora_api_timeout;
    }

    location @nexora_api_unavailable {
        default_type application/json;
        return 502 '{"statusCode":502,"message":"El servidor de Nexora no está disponible en este momento. Reintenta en unos segundos."}';
    }

    location @nexora_api_timeout {
        default_type application/json;
        return 504 '{"statusCode":504,"message":"El servidor de Nexora tardó demasiado en responder. Reintenta en unos segundos."}';
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location = /runtime-config.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    # `types {}` vacía la tabla de tipos de esta ubicación para que el tipo
    # no dependa de la versión de mime.types de la imagen.
    location = /manifest.webmanifest {
        types {}
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    # Archivos ocultos (/.env, /.git/config...) y mapas de código: nunca se
    # sirven ni caen en el fallback de la SPA.
    location ~ /\. {
        access_log off;
        return 404;
    }

    location ~* \.map$ {
        access_log off;
        return 404;
    }

    # Vite genera /assets/* con hash en el nombre: son inmutables. La cabecera
    # va sin `always` para que un 404 nunca quede cacheado como inmutable.
    location ~ ^/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    # Avisos de licencias (/licencias.txt, que genera scripts/licencias-web.mjs,
    # y cualquier otro .txt): texto UTF-8 con charset explícito. `charset`
    # sólo actúa en esta ubicación, así que el resto de tipos conserva su
    # Content-Type; la caché y las cabeceras de seguridad son las del bloque
    # genérico de abajo.
    location ~* \.txt$ {
        charset utf-8;
        charset_types text/plain;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    # Resto de archivos con extensión (icon.svg, registerSW.js, workbox-*.js,
    # products/*.svg...): se sirven si existen y revalidan siempre; si no
    # existen, 404 y no el HTML de la SPA.
    location ~ \.[A-Za-z0-9]+$ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    # Rutas de la SPA (sin extensión): fallback a index.html, que se sirve por
    # redirección interna con su Cache-Control no-store.
    location / {
        try_files $uri /index.html;
    }
}
