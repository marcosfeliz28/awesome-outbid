map $remote_addr $nexora_client_ip {
    default $remote_addr;
}

# La IP de la API la mantiene start-nginx.sh (re-resuelve cada 10 s y recarga).
upstream nexora_api {
    include /etc/nginx/snippets/nexora-api-upstream.conf;
    keepalive 16;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 5m;
    include /etc/nginx/snippets/nexora-security-headers.conf;

    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        # La web sólo es sana si la API responde; el cuerpo de la API no se
        # expone: auth_request descarta la respuesta y sólo se devuelve 204/503.
        auth_request /_nexora_api_live;
        error_page 500 502 503 504 =503 @nexora_api_down;
        # `return` se evalúa antes de auth_request; try_files, después.
        try_files /nexora-inexistente @nexora_healthy;
    }

    location @nexora_healthy {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        return 204;
    }

    location = /_nexora_api_live {
        internal;
        proxy_pass http://nexora_api/api/health/live;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    location @nexora_api_down {
        add_header Cache-Control "no-store" always;
        return 503;
    }

    location = /api/events {
        proxy_pass http://nexora_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $nexora_client_ip;
        proxy_set_header X-Forwarded-For $nexora_client_ip;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        add_header X-Accel-Buffering no;
    }

    location /api/ {
        proxy_pass http://nexora_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $nexora_client_ip;
        proxy_set_header X-Forwarded-For $nexora_client_ip;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location = /runtime-config.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
