map $remote_addr $nexora_client_ip {
    default $remote_addr;
}

resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

upstream nexora_api {
    zone nexora_api 64k;
    server ${API_UPSTREAM} resolve;
    keepalive 16;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 5m;
    include /etc/nginx/snippets/nexora-security-headers.conf;

    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        return 204;
    }

    location = /api/events {
        proxy_pass http://nexora_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $nexora_client_ip;
        proxy_set_header X-Forwarded-For $nexora_client_ip;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        add_header X-Accel-Buffering no;
    }

    location /api/ {
        proxy_pass http://nexora_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $nexora_client_ip;
        proxy_set_header X-Forwarded-For $nexora_client_ip;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location = /runtime-config.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/nexora-security-headers.conf;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
