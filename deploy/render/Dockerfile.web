# syntax=docker/dockerfile:1.7
FROM node:24.21.0-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile --filter @fitstore/web...

COPY tsconfig.base.json ./
COPY apps/web apps/web
COPY packages/shared packages/shared
COPY packages/ui packages/ui
# G8: Sentry de la web sólo se activa si Render entrega VITE_SENTRY_DSN al
# compilar (las variables del servicio llegan como argumentos de compilación).
# Sin ella la app no envía nada a Sentry.
ARG VITE_SENTRY_DSN=""
RUN pnpm --filter @fitstore/web build

# Nginx abierto incorpora `resolve` para upstreams desde 1.27.3. Se fija una
# versión posterior concreta para no depender de la etiqueta flotante latest.
FROM nginx:1.30.5-alpine3.24 AS runtime
ENV NGINX_ENVSUBST_FILTER="^(API_UPSTREAM|PORT)$"
RUN apk add --no-cache musl-utils && mkdir -p /etc/nginx/snippets
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY deploy/render/nginx.conf.template /etc/nginx/templates/default.conf.template
# El snippet de cabeceras se genera al arrancar (start-nginx.sh) para que la
# CSP sólo incluya Sentry cuando hay VITE_SENTRY_DSN.
COPY deploy/render/security-headers.conf /etc/nginx/nexora/security-headers.conf.in
COPY --chmod=755 deploy/render/render-security-headers.sh /usr/local/bin/nexora-render-security-headers
COPY --chmod=755 deploy/render/render-trusted-edge.sh /usr/local/bin/nexora-render-trusted-edge
COPY --chmod=755 deploy/render/start-nginx.sh /usr/local/bin/nexora-nginx-entrypoint
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:${PORT:-10000}/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/nexora-nginx-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
