}

// Instantánea por línea vendida (kind "sale") y sus reversos negativos por
// devolución ("return", refId = devolución) o anulación ("void", refId =
// venta). El monto ya viene calculado: cantidad × tarifa × 0.5 si mayorista.
// period es el mes (America/Santo_Domingo) en que cuenta; originPeriod, el de
// la venta original.
model IncentiveEntry {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id           String   @id @default(uuid()) @db.Uuid
  kind         String
  refId        String   @db.Uuid
  saleId       String   @db.Uuid
  saleItemId   String   @db.Uuid
  userId       String   @db.Uuid
  categoryId   String?  @db.Uuid
  categoryName String
  qty          Decimal  @db.Decimal(14, 3)
  rateAtSale   Decimal  @db.Decimal(14, 2)
  wholesale    Boolean  @default(false)
  amount       Decimal  @db.Decimal(14, 2)
  period       String
  originPeriod String
  note         String?
  branchId     String   @default("main")
  createdAt    DateTime @default(now())

  @@unique([saleItemId, kind, refId])
  @@index([branchId, period, userId])
  @@index([saleId])
}

// Cierre de un mes: marca inmutable por sucursal y mes.
model IncentivePeriodClose {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @default("main")
  period    String
  closedBy  String   @db.Uuid
  closedAt  DateTime @default(now())

  @@unique([branchId, period])
}

// Cuadre cerrado de una cajera en un mes: instantánea inmutable.
model IncentiveSettlement {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @default("main")
  period            String
  userId            String   @db.Uuid
  userName          String
  units             Json
  salesCount        Int
  wholesaleSales    Int
  gross             Decimal  @db.Decimal(14, 2)
  deductions        Decimal  @db.Decimal(14, 2)
  net               Decimal  @db.Decimal(14, 2)
  pendingCollection Decimal  @db.Decimal(14, 2)
  priorDeductions   Decimal  @db.Decimal(14, 2)
  entryCount        Int
  closedBy          String   @db.Uuid
  closedByName      String
  closedAt          DateTime @default(now())

  @@unique([branchId, period, userId])
}

// Respaldo diario cifrado a Google Drive (apps/api/src/drive-backup.ts,
// docs/RESPALDO_DRIVE.md). Una sola fila «main». refreshTokenEnc va cifrado
// con AES-256-GCM (clave derivada de BACKUP_ENCRYPTION_KEY); jamás en claro ni
// en respuestas. lockId/lockedUntil: arriendo para un solo respaldo a la vez.
model DriveBackup {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id                  String    @id @default("main")
  refreshTokenEnc     String?
  accountEmail        String?
  folderId            String?
  branchId            String    @default("main")
  connectedAt         DateTime?
  connectedBy         String?
  authError           String?
  lockId              String?
  lockedUntil         DateTime?
  runningSince        DateTime?
  lastRunAt           DateTime?
  lastTrigger         String?
  lastStatus          String?
  lastError           String?
  lastDurationMs      Int?
  lastSuccessAt       DateTime?
  lastSize            BigInt?
  lastFileName        String?
  consecutiveFailures Int       @default(0)
  dayKey              String?
  dayAttempts         Int       @default(0)
  nextRetryAt         DateTime?
  lastAlertAt         DateTime?
  updatedAt           DateTime  @default(now()) @updatedAt
}

// Empresa cliente. El tenant demo sólo existe en la base independiente del producto.
model Tenant {
  // Relaciones explícitas para que Prisma y la migración coincidan.
  roleRows Role[]
  userRows User[]
  refreshTokenRows RefreshToken[]
  categoryRows Category[]
  brandRows Brand[]
  supplierRows Supplier[]
  productRows Product[]
  variantRows Variant[]
  kitComponentRows KitComponent[]
  lotRows Lot[]
  lotIdentityConflictRows LotIdentityConflict[]
  inventoryMovementRows InventoryMovement[]
  warehouseRows Warehouse[]
  variantStockRows VariantStock[]
  lotStockRows LotStock[]
  stockTransferRows StockTransfer[]
  stockTransferLineRows StockTransferLine[]
  customerRows Customer[]
  saleRows Sale[]
  saleVoidRequestRows SaleVoidRequest[]
  courierPayoutRows CourierPayout[]
  courierPayoutItemRows CourierPayoutItem[]
  saleItemRows SaleItem[]
  paymentRows Payment[]
  creditAllocationOperationRows CreditAllocationOperation[]
  saleReturnRows SaleReturn[]
  creditNoteRows CreditNote[]
  quoteRows Quote[]
  purchaseOrderRows PurchaseOrder[]
  purchaseItemRows PurchaseItem[]
  goodsReceiptRows GoodsReceipt[]
  supplierPaymentRows SupplierPayment[]
  inventoryCountRows InventoryCount[]
  cashSessionRows CashSession[]
  cashMovementRows CashMovement[]
  expenseCategoryRows ExpenseCategory[]
  expenseRows Expense[]
  promotionRows Promotion[]
  alertRows Alert[]
  ncfSequenceRows NcfSequence[]
  alertRuleRows AlertRule[]
  auditLogRows AuditLog[]
  settingsRows Settings[]
  counterRows Counter[]
  authAttemptRows AuthAttempt[]
  authSessionRows AuthSession[]
  mcpAuthorizationCodeRows McpAuthorizationCode[]
  terminalRows Terminal[]
  realtimeEventRows RealtimeEvent[]
  merchandiseOperationRows MerchandiseOperation[]
  supplierImportProfileRows SupplierImportProfile[]
  supplierCodeRows SupplierCode[]
  invoiceDraftRows InvoiceDraft[]
  invoiceAttachmentRows InvoiceAttachment[]
  objectDeletionRows TenantObjectDeletion[]
  notificationOutboxRows NotificationOutbox[]
  incentiveRateRows IncentiveRate[]
  incentiveEntryRows IncentiveEntry[]
  incentivePeriodCloseRows IncentivePeriodClose[]
  incentiveSettlementRows IncentiveSettlement[]
  driveBackupRows DriveBackup[]
  lifecycleNoticeRows TenantLifecycleNotice[]
  billingRequestRows BillingRequest[]
  billingDecisionRows BillingDecision[]
  aiPackCreditRows AiPackCredit[]
  platformPaymentRows PlatformPayment[]
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  businessType String @default("general")
  // Consentimiento del dueño al alta. Nulos para empresas previas: no se
  // presupone aceptación retroactiva de textos nuevos.
  termsVersion String?
  termsAcceptedAt DateTime?
  privacyVersion String?
  privacyAcceptedAt DateTime?
  trialEndsAt DateTime?
  paidThroughAt DateTime?
  pastDueAt DateTime?
  suspendedAt DateTime?
  plan      String   @default("trial")
  status    String   @default("trial")
  country   String   @default("DO")
  currency  String   @default("DOP")
  timeZone  String   @default("America/Santo_Domingo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// PC-23: pago manual registrado por el operador de la plataforma. Sólo
// INSERT (trigger en la base); sin datos de tarjeta.
model PlatformPayment {
  id        String   @id @default(uuid()) @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantId  String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  reference String
  months    Int
  operator  String
  paidFrom  DateTime
  paidUntil DateTime
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Avisos de vencimiento durables e idempotentes por empresa y período.
model TenantLifecycleNotice {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind String
  dueAt DateTime
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  createdAt DateTime @default(now())

  @@unique([tenantId, kind, dueAt])
  @@index([tenantId])
  @@index([status, nextAttemptAt])
}

// Solicitud de cobro del producto: independiente de Payment (ventas de la tienda).
model BillingRequest {
  id            String   @id @default(uuid()) @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenantId      String   @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  plan          String
  provider      String
  amount        Decimal  @db.Decimal(12, 2)
  status        String   @default("pending_proof")
  proof         Bytes?
  proofObjectKey String?
  proofMime     String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewer      String?
  reviewReason  String?
  paidThroughAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  decision      BillingDecision?

  @@index([tenantId, createdAt])
  @@index([status, submittedAt])
  @@unique([tenantId, proofObjectKey])
}

model BillingDecision {
  id         String         @id @default(uuid()) @db.Uuid
  request    BillingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  requestId  String         @unique @db.Uuid
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenantId   String         @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  decision   String
  reviewer   String
  reason     String
  createdAt  DateTime       @default(now())

  @@index([tenantId, createdAt])
}

// PC-24: paquete extra de preguntas de IA (pago manual). Inmutable; vale solo
// para el mes (zona de la empresa) en que se acredita.
model AiPackCredit {
  id        String   @id @default(uuid()) @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenantId  String   @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  month     String
  questions Int
  priceDop  Decimal  @db.Decimal(12, 2)
  reference String
  createdAt DateTime @default(now())

  @@unique([tenantId, reference])
  @@index([tenantId, month])
}
