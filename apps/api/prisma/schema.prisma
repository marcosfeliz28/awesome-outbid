generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  @@unique([tenantId, name])
  permissions String[]
  users       User[]
  updatedAt   DateTime @updatedAt
}

model User {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  // Nombre corto que la persona escribe para entrar (por ejemplo, "E Soto").
  username           String?
  // Versión normalizada, sin acentos y en minúsculas, para buscar sin errores.
  usernameKey        String?
  email              String
  @@unique([tenantId, usernameKey])
  @@unique([tenantId, email])
  passwordHash       String
  // Alta autoservicio: sólo el dueño nuevo empieza sin verificar.
  emailVerifiedAt    DateTime? @default(now())
  emailVerificationHash String? @unique
  emailVerificationExpiresAt DateTime?
  mustChangePassword Boolean   @default(false)
  // N-08: una contraseña temporal vence (7 días). Null = sin vencimiento
  // (cambio de contraseña forzado por política, no por una clave temporal).
  passwordExpiresAt  DateTime?
  supportExpiresAt   DateTime?
  pinHash            String
  roleId             String    @db.Uuid
  role               Role      @relation(fields: [roleId], references: [id])
  active             Boolean   @default(true)
  authVersion        Int       @default(0)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  branchId           String    @default("main")
  // Número de cajero visible en el cuadre y los reportes (p. ej. 1031).
  cashierNumber      Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  voidRequestsMade   SaleVoidRequest[] @relation("VoidRequestRequester")
  voidRequestsReviewed SaleVoidRequest[] @relation("VoidRequestReviewer")
  courierPaymentsMade Sale[] @relation("CourierPaidBy")
  courierPayouts CourierPayout[] @relation("CourierPayoutActor")
}

model RefreshToken {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  authVersion Int      @default(0)
  sessionId   String?  @db.Uuid
  hash        String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Category {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  @@unique([tenantId, name])
  requiresLot    Boolean   @default(false)
  requiresExpiry Boolean   @default(false)
  color          String    @default("#7C3AED")
  attributes     Json      @default("[]")
  products       Product[]
  branchId       String    @default("main")
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Brand {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id   String @id @default(uuid()) @db.Uuid
  name String
  @@unique([tenantId, name])
}

model Supplier {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  legalId          String?
  phone            String?
  email            String?
  paymentTermsDays Int      @default(30)
  leadTimeDays     Int      @default(7)
  active           Boolean  @default(true)
  branchId         String   @default("main")
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Product {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  sku         String
  @@unique([tenantId, sku])
  categoryId  String    @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id])
  brand       String    @default("FitStore")
  supplierId  String?   @db.Uuid
  description String    @default("")
  imageUrl    String?
  taxRate     Decimal   @default(18) @db.Decimal(5, 2)
  minStock    Decimal   @default(5) @db.Decimal(14, 3)
  maxStock    Decimal   @default(80) @db.Decimal(14, 3)
  unit        String    @default("unidad")
  location    String    @default("")
  active      Boolean   @default(true)
  isKit       Boolean   @default(false)
  // false sólo para kg/lb/litro o productos con decimales históricos
  // (202610290001_sold_by_unit): los demás rechazan cantidades fraccionadas.
  soldByUnit  Boolean   @default(true)
  variants    Variant[]
  branchId    String    @default("main")
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Variant {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id             String              @id @default(uuid()) @db.Uuid
  productId      String              @db.Uuid
  product        Product             @relation(fields: [productId], references: [id])
  sku            String
  barcode        String
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  attributes     Json                @default("{}")
  costAvg        Decimal             @db.Decimal(14, 2)
  price          Decimal             @db.Decimal(14, 2)
  wholesalePrice Decimal?            @db.Decimal(14, 2)
  stock          Decimal             @default(0) @db.Decimal(14, 3)
  active         Boolean             @default(true)
  lots           Lot[]
  warehouseStocks VariantStock[]
  transferLines StockTransferLine[]
  movements      InventoryMovement[]
  saleItems      SaleItem[]
  // Claves foráneas de 202610210002_datos_restricciones.
  purchaseItems  PurchaseItem[]
  kitComponents  KitComponent[]      @relation("KitVariant")
  usedInKits     KitComponent[]      @relation("KitComponentVariant")
  branchId       String              @default("main")
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // K2 (migración 202610170001_variant_code_unique): además de los @unique
  // exactos, la base impone índices únicos de expresión que Prisma no
  // representa, globales como los anteriores:
  //   "Variant_sku_ci_key"     ON (lower(btrim(sku)))     WHERE btrim(sku) <> ''
  //   "Variant_barcode_ci_key" ON (lower(btrim(barcode))) WHERE btrim(barcode) <> ''
  // Si al migrar ya había repetidos, el índice se omite (NOTICE + AuditLog
  // k2_code_index_skipped) hasta corregirlos y volver a ejecutar la migración.

  // Migración 202610200001_perf_indexes_links (enlaces entre tablas).
  @@index([productId])
}

model KitComponent {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id                 String  @id @default(uuid()) @db.Uuid
  kitVariantId       String  @db.Uuid
  kitVariant         Variant @relation("KitVariant", fields: [kitVariantId], references: [id])
  componentVariantId String  @db.Uuid
  componentVariant   Variant @relation("KitComponentVariant", fields: [componentVariantId], references: [id])
  // CHECK kit_component_qty_positive (qty > 0), 202610210002.
  qty                Decimal @db.Decimal(14, 3)

  @@unique([kitVariantId, componentVariantId])
}

model Lot {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id                  String              @id @default(uuid()) @db.Uuid
  variantId           String              @db.Uuid
  variant             Variant             @relation(fields: [variantId], references: [id])
  lotNumber           String
  lotNumberNormalized String
  expiryDate          DateTime?
  qty                 Decimal             @db.Decimal(14, 3)
  cost                Decimal             @db.Decimal(14, 2)
  branchId            String              @default("main")
  createdBy           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  movements           InventoryMovement[]
  warehouseStocks     LotStock[]
  transferLines       StockTransferLine[]
  saleItems           SaleItem[]

  @@unique([variantId, lotNumberNormalized])
  @@index([expiryDate])
}

// Evidencia de duplicados históricos resueltos por la migración I1. No tiene
// relaciones deliberadamente: conserva los identificadores aunque el lote sea
// eliminado años después.
model LotIdentityConflict {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  conflictKey         String    @id
  variantId           String    @db.Uuid
  lotNumberNormalized String
  keeperLotId         String    @db.Uuid
  sourceLotIds        Json
  expiryDates         Json
  chosenExpiryDate    DateTime?
  resolution          String
  createdAt           DateTime  @default(now())
}

model InventoryMovement {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id           String   @id @default(uuid()) @db.Uuid
  variantId    String   @db.Uuid
  variant      Variant  @relation(fields: [variantId], references: [id])
  lotId        String?  @db.Uuid
  lot          Lot?     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  type         String
  qty          Decimal  @db.Decimal(14, 3)
  unitCost     Decimal  @db.Decimal(14, 2)
  balanceAfter Decimal  @db.Decimal(14, 3)
  refId        String?
  reason       String
  userId       String
  branchId     String   @default("main")
  warehouseId  String?  @db.Uuid
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt    DateTime @default(now())

  @@index([lotId])
  @@index([variantId, createdAt])
  @@index([branchId, createdAt])
}

model Warehouse {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  branchId String @default("main")
  name String
  kind String
  active Boolean @default(true)
  sellable Boolean @default(false)
  stocks VariantStock[]
  lotStocks LotStock[]
  outgoingTransfers StockTransfer[] @relation("TransferFrom")
  incomingTransfers StockTransfer[] @relation("TransferTo")
  movements InventoryMovement[]
  counts InventoryCount[]
  @@unique([tenantId, branchId, kind])
  @@unique([tenantId, branchId, name])
}

model VariantStock {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  variantId String @db.Uuid
  warehouseId String @db.Uuid
  qty Decimal @default(0) @db.Decimal(14, 3)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  @@id([variantId, warehouseId])
  @@index([warehouseId])
}

model LotStock {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  lotId String @db.Uuid
  warehouseId String @db.Uuid
  qty Decimal @default(0) @db.Decimal(14, 3)
  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  @@id([lotId, warehouseId])
}

model StockTransfer {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  operationId String @db.Uuid
  @@unique([tenantId, operationId])
  branchId String @default("main")
  fromId String @db.Uuid
  toId String @db.Uuid
  from Warehouse @relation("TransferFrom", fields: [fromId], references: [id])
  to Warehouse @relation("TransferTo", fields: [toId], references: [id])
  reason String
  userId String
  createdAt DateTime @default(now())
  lines StockTransferLine[]
  @@index([branchId, createdAt])
}

model StockTransferLine {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  transferId String @db.Uuid
  variantId String @db.Uuid
  lotId String? @db.Uuid
  lot Lot? @relation(fields: [lotId], references: [id], onDelete: Restrict)
  qty Decimal @db.Decimal(14, 3)
  transfer StockTransfer @relation(fields: [transferId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])
  @@index([variantId])
}

model Customer {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id          String    @id @default(uuid()) @db.Uuid
  creditLimit Decimal   @default(0) @db.Decimal(14, 2)
  name        String
  phone       String?
  email       String?
  legalId     String?
  notes       String    @default("")
  active      Boolean   @default(true)
  anonymizedAt DateTime?
  branchId    String    @default("main")
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Claves foráneas de 202610210002_datos_restricciones (un cliente no se
  // borra: se anonimiza).
  sales        Sale[]
  creditNotes  CreditNote[]
}

model Sale {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id                     String       @id @default(uuid()) @db.Uuid
  number                 String
  @@unique([tenantId, number])
  status                 String       @default("completed")
  offlineUuid            String       @db.Uuid
  @@unique([tenantId, offlineUuid])
  requestHash            String       @default("")
  customerId             String?      @db.Uuid
  customer               Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId               String       @db.Uuid
  cashSessionId          String?      @db.Uuid
  cashSession            CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  // CHECK sale_amounts_nonnegative y sale_status_valid (completed | voided),
  // migración 202610210002_datos_restricciones.
  subtotal               Decimal      @db.Decimal(14, 2)
  discountTotal          Decimal      @db.Decimal(14, 2)
  discountReason         String?
  discountRule           String?
  discountApprovedBy   String?      @db.Uuid
  discountApprovedName String?
  discountApprovedRole String?
  taxTotal               Decimal      @db.Decimal(14, 2)
  taxIncluded            Boolean      @default(true)
  total                  Decimal      @db.Decimal(14, 2)
  costTotal              Decimal      @db.Decimal(14, 2)
  // Envío de tercero: nunca forma parte de total, costo ni caja.
  courierFee             Decimal      @default(0) @db.Decimal(12, 2)
  courierName            String?      @default("Addison")
  courierPaidAt          DateTime?
  courierPaidById        String?      @db.Uuid
  courierPaidBy          User?        @relation("CourierPaidBy", fields: [courierPaidById], references: [id], onDelete: Restrict)
  courierPayoutItem      CourierPayoutItem?
  creditBalance          Decimal      @default(0) @db.Decimal(14, 2)
  creditDueDate          DateTime?
  // Cuenta por cobrar saldada (migración 202610240201_credito_cobros): cuándo
  // y quién dejó el saldo en cero. Nulo mientras el crédito está abierto.
  creditClosedAt         DateTime?
  creditClosedById       String?      @db.Uuid
  // Incentivo al cobrar: las ventas a crédito nuevas acreditan el incentivo de
  // la cajera a medida que se cobran (docs/INCENTIVOS.md). false = venta
  // anterior, que sigue el comportamiento viejo (todo al vender).
  incentiveOnCollection  Boolean      @default(false)
  // Etiqueta de estadística de la venta por cobrar (dueña, 19-oct): "credit"
  // (Crédito) o "cod" (Contraentrega). Mismas reglas y mismo cobro; nulo en
  // ventas anteriores o sin saldo (migración 202610250201_receivable_kind).
  receivableKind         String?
  ncf                    String?
  @@unique([tenantId, ncf])
  ncfType                String?
  recipientLegalId       String?
  fiscalStatus           String       @default("not_issued")
  notes                  String       @default("")
  voidedReason           String?
  voidedBy               String?
  // «Venta al por mayor» (INC): sólo reduce el incentivo de la cajera a la
  // mitad; no cambia precios ni totales (docs/INCENTIVOS.md).
  wholesale              Boolean      @default(false)
  items                  SaleItem[]
  payments               Payment[]
  returns                SaleReturn[]
  voidRequests           SaleVoidRequest[]
  branchId               String       @default("main")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  // Migración 202610210001_datos_indices (deuda del cliente, anonimización).
  @@index([customerId])
  @@index([createdAt])
  @@index([sellerId, createdAt])
  // Migración 202610200001_perf_indexes_links (enlaces entre tablas).
  @@index([cashSessionId])
}

model SaleVoidRequest {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @db.Uuid
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedById  String   @db.Uuid
  requester      User     @relation("VoidRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById   String?  @db.Uuid
  reviewer       User?    @relation("VoidRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  operationId    String   @db.Uuid
  @@unique([tenantId, operationId])
  reasonCode     String
  reason         String
  status         String   @default("pending")
  resolutionNote String?
  requestedAt    DateTime @default(now())
  reviewedAt     DateTime?
  cancelledAt    DateTime?
  updatedAt      DateTime @updatedAt
  branchId       String   @default("main")

  @@index([branchId, status, requestedAt])
  @@index([saleId])
  @@index([requestedById, requestedAt])
}

model CourierPayout {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  operationId String @db.Uuid
  @@id([tenantId, operationId])
  branchId String
  actorId String @db.Uuid
  actor User @relation("CourierPayoutActor", fields: [actorId], references: [id], onDelete: Restrict)
  note String?
  requestHash String
  total Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  items CourierPayoutItem[]

  @@index([branchId, createdAt])
}

model CourierPayoutItem {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id String @id @default(uuid()) @db.Uuid
  payoutId String @db.Uuid
  payout CourierPayout @relation(fields: [tenantId, payoutId], references: [tenantId, operationId], onDelete: Restrict)
  saleId String @unique @db.Uuid
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  fee Decimal @db.Decimal(12, 2)

  @@index([payoutId])
}

model SaleItem {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id               String  @id @default(uuid()) @db.Uuid
  saleId           String  @db.Uuid
  sale             Sale    @relation(fields: [saleId], references: [id])
  variantId        String  @db.Uuid
  variant          Variant @relation(fields: [variantId], references: [id])
  lotId            String? @db.Uuid
  lot              Lot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  qty              Decimal @db.Decimal(14, 3)
  returnedQty      Decimal @default(0) @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(14, 2)
  unitCost         Decimal @db.Decimal(14, 2)
  discount         Decimal @db.Decimal(14, 2)
  tax              Decimal @db.Decimal(14, 2)
  lineTotal        Decimal @db.Decimal(14, 2)
  stockAllocations Json    @default("[]")
  // Promoción automática aplicada (copia del nombre al vender) · G15.
  promotionName    String?

  @@index([variantId])
  @@index([lotId])
  // Migración 202610200001_perf_indexes_links (enlaces entre tablas).
  @@index([saleId])
}

model Payment {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @db.Uuid
  sale           Sale     @relation(fields: [saleId], references: [id])
  cashSessionId  String?  @db.Uuid
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  creditNoteId   String?  @db.Uuid
  creditNote     CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  // CHECK payment_amounts_nonnegative (monto, entregado, cambio, comisión).
  entryType      String   @default("sale")
  idempotencyKey String?  @db.Uuid
  @@unique([tenantId, idempotencyKey])
  createdAt      DateTime @default(now())
  method         String
  amount         Decimal  @db.Decimal(14, 2)
  tendered       Decimal  @db.Decimal(14, 2)
  change         Decimal  @default(0) @db.Decimal(14, 2)
  bank           String?
  reference      String?
  cardBrand      String?
  cardLast4      String?
  approvalCode   String?
  cardType       String?
  feeAmount      Decimal  @default(0) @db.Decimal(14, 2)
  status         String   @default("ok")
  proofUrl       String?
  // Quién recibió el dinero de un cobro de crédito (administrador que lo
  // registró). Migración 202610240201_credito_cobros.
  receivedById   String?  @db.Uuid

  // Migración 202610200001_perf_indexes_links (enlaces entre tablas).
  @@index([saleId])
  @@index([cashSessionId])
}

// Un cobro por cliente puede abarcar varias ventas; conserva la respuesta y
// el hash del pedido para reintentos sin volver a mover caja ni incentivos.
model CreditAllocationOperation {
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  @@index([tenantId])
  operationId String   @db.Uuid
  @@id([tenantId, operationId])
  branchId    String
